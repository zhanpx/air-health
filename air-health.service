[Unit]
Description=Private Google Health dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airhealth
Group=airhealth
WorkingDirectory=/opt/air-health
Environment=PYTHONUNBUFFERED=1
Environment=HEALTH_DATA_DIR=/var/lib/air-health
UMask=0077
ExecStart=/usr/bin/python3 /opt/air-health/app.py serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/air-health
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

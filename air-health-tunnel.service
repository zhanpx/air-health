[Unit]
Description=Air Health HTTPS tunnel
After=network-online.target air-health-web-gateway.service
Wants=network-online.target air-health-web-gateway.service

[Service]
Type=simple
User=airhealth
Group=airhealth
Environment=HOME=/var/lib/airhealth-tunnel
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8766 --metrics 127.0.0.1:20242
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
